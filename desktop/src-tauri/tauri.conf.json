{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whispr",
  "version": "0.1.0",
  "identifier": "app.whispr.desktop",
  "build": {
    "frontendDist": "../dist-shim"
  },
  "app": {
    "windows": [
      {
        "title": "Whispr",
        "url": "https://whisper-flow-chats.lovable.app",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Private messaging, beautifully done",
    "longDescription": "Whispr is a privacy-first communication platform for messaging, calls, and communities.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null
    }
  }
}
